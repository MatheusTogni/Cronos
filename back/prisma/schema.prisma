generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER
  PLAYER
}

enum CampaignStatus {
  DRAFT // mestre preparando
  LOBBY // aberta para os jogadores entrarem
  ACTIVE // aventura em andamento
  ENDED
}

enum AbilityKind {
  BASIC
  SKILL
}

/// Efeito automático aplicado ao usar a habilidade (além de descontar mana e gerar log).
enum AbilityEffect {
  SUMMON // cria uma invocação no personagem
  SACRIFICE_SUMMON // consome uma invocação existente
  SELF_CONDITION // aplica condição no próprio personagem
  TARGET_CONDITION // aplica condição no personagem-alvo (quando o alvo é alguém da party)
}

enum LogType {
  DAMAGE
  HEAL
  MANA
  XP
  LEVEL
  ABILITY_USED
  DICE_ROLL
  CONDITION_ADDED
  CONDITION_REMOVED
  SUMMON_CREATED
  SUMMON_REMOVED
  SUMMON_UPDATED
  ITEM_ADDED
  ITEM_REMOVED
  ITEM_UPDATED
  CAMPAIGN
  NOTE
  TURN
  NPC_CREATED
  NPC_UPDATED
  NPC_REMOVED
}

/// Se a condição ajuda (BUFF), atrapalha (DEBUFF) ou depende do alvo (NEUTRAL).
enum ConditionPolarity {
  BUFF
  DEBUFF
  NEUTRAL
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaignsMastered Campaign[]
  campaignSeats     CampaignPlayer[]
  characters        Character[]
  logEntries        LogEntry[]

  @@map("users")
}

model Campaign {
  id           String         @id @default(uuid())
  name         String
  description  String?
  status       CampaignStatus @default(DRAFT)
  masterId     String
  shownImageId String?        @unique
  createdAt    DateTime       @default(now())
  startedAt    DateTime?
  endedAt      DateTime?

  /// Combate (modo de turnos), ligado e desligado pelo mestre.
  inCombat  Boolean  @default(false)
  round     Int      @default(0)
  /// 0 = turno do mestre; i > 0 = personagem turnOrder[i - 1].
  turnIndex Int      @default(0)
  /// Ordem dos personagens no combate (ids). O mestre sempre abre a rodada.
  turnOrder String[] @default([])

  master     User             @relation(fields: [masterId], references: [id])
  shownImage CampaignImage?   @relation("ShownImage", fields: [shownImageId], references: [id], onDelete: SetNull)
  images     CampaignImage[]  @relation("CampaignImages")
  players    CampaignPlayer[]
  characters Character[]
  npcs       Npc[]
  logEntries LogEntry[]

  @@map("campaigns")
}

model CampaignPlayer {
  campaignId String
  userId     String
  ready      Boolean  @default(false)
  joinedAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
  @@map("campaign_players")
}

model CharacterClass {
  id           String   @id // slug: "necromante", "raposa-vermelha"...
  name         String
  tagline      String? // subtítulo da ficha, ex.: "Torturador / Carrasco"
  categories   String[]
  identity     String
  mechanicName String
  mechanicText String
  baseHp       Int
  baseMana     Int
  maxSummons   Int      @default(0)
  color        String // cor de destaque da ficha (hex)
  artFile      String // caminho público da arte, ex.: "/classes/necromante.png"
  sortOrder    Int      @default(0)

  abilities  Ability[]
  characters Character[]

  @@map("character_classes")
}

model Ability {
  id          String         @id @default(uuid())
  classId     String
  kind        AbilityKind
  name        String
  manaCost    Int            @default(0)
  /// Ataque: o valor do d20 (digitado pelo mestre) vira o dano no alvo.
  dealsDamage Boolean        @default(false)
  /// Pergunta feita ao jogador antes de usar (ex.: "O que você aposta?"); a resposta vai no log.
  prompt      String?
  description String
  /// Lista de faixas de crítico: [{ "min": 18, "max": 20, "text": "..." }]
  crits       Json?
  effect      AbilityEffect?
  /// Parâmetros do efeito, ex.: { "name": "Máscara da Serenidade", "exclusiveGroup": "mascara" }
  effectData  Json?
  sortOrder   Int            @default(0)

  class CharacterClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, name])
  @@map("abilities")
}

model Character {
  id         String   @id @default(uuid())
  campaignId String
  userId     String
  classId    String
  name       String
  level      Int      @default(1)
  xp         Int      @default(0)
  hp         Int
  hpMax      Int
  mana       Int
  manaMax    Int
  /// Instabilidade temporal (Tecelão do Tempo): sobe a cada uso e rompe em paradoxo no limite.
  instability Int     @default(0)
  notes      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id])
  class      CharacterClass  @relation(fields: [classId], references: [id])
  summons    Summon[]
  conditions Condition[]
  inventory  InventoryItem[]
  logEntries LogEntry[]

  @@unique([campaignId, userId])
  @@map("characters")
}

model Summon {
  id          String   @id @default(uuid())
  characterId String
  name        String
  hp          Int
  hpMax       Int
  notes       String   @default("")
  createdAt   DateTime @default(now())

  character  Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  conditions Condition[]

  @@map("summons")
}

/// Inimigo/NPC controlado pelo mestre (age no turno do mestre).
model Npc {
  id         String   @id @default(uuid())
  campaignId String
  name       String
  hp         Int
  hpMax      Int
  notes      String   @default("")
  createdAt  DateTime @default(now())

  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  conditions Condition[]

  @@map("npcs")
}

/// Catálogo de condições (prisma/seed/conditions.json).
model ConditionDef {
  id             String            @id // slug: "sangrando", "lua-rubra"...
  name           String
  description    String
  polarity       ConditionPolarity @default(NEUTRAL)
  /// Duração padrão em turnos de quem carrega; null = até alguém remover.
  turns          Int?
  /// Vida por turno, aplicada no fim do turno de quem carrega (negativo = dano).
  hpPerTurn      Int               @default(0)
  /// Quem carrega perde a vez.
  skipsTurn      Boolean           @default(false)
  exclusiveGroup String?
  sortOrder      Int               @default(0)

  conditions Condition[]

  @@map("condition_defs")
}

model Condition {
  id             String            @id @default(uuid())
  characterId    String?
  summonId       String?
  npcId          String?
  defId          String?
  name           String
  description    String?
  source         String? // quem aplicou (texto livre ou nome do personagem)
  exclusiveGroup String? // ex.: "mascara" — só uma condição do grupo por alvo
  duration       String? // legado: texto livre de antes dos turnos
  polarity       ConditionPolarity @default(NEUTRAL)
  /// Turnos restantes de quem carrega; desconta no fim do turno dele. null = sem prazo.
  turnsLeft      Int?
  hpPerTurn      Int               @default(0)
  skipsTurn      Boolean           @default(false)
  createdAt      DateTime          @default(now())

  character Character?    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  summon    Summon?       @relation(fields: [summonId], references: [id], onDelete: Cascade)
  npc       Npc?          @relation(fields: [npcId], references: [id], onDelete: Cascade)
  def       ConditionDef? @relation(fields: [defId], references: [id], onDelete: SetNull)

  @@map("conditions")
}

model InventoryItem {
  id          String   @id @default(uuid())
  characterId String
  name        String
  qty         Int      @default(1)
  description String?
  createdAt   DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("inventory_items")
}

model CampaignImage {
  id           String   @id @default(uuid())
  campaignId   String
  filename     String // nome no disco (uuid + extensão)
  originalName String
  title        String
  createdAt    DateTime @default(now())

  campaign Campaign  @relation("CampaignImages", fields: [campaignId], references: [id], onDelete: Cascade)
  shownIn  Campaign? @relation("ShownImage")

  @@map("campaign_images")
}

model LogEntry {
  id            String    @id @default(uuid())
  campaignId    String
  actorUserId   String?
  characterId   String?
  type          LogType
  /// Texto que os jogadores leem (narrado, sem números do que é do mestre).
  message       String
  /// Versão completa, só para o mestre (ex.: com a vida dos inimigos). Null = igual a `message`.
  masterMessage String?
  /// Valores antes/depois, usados pelo "desfazer" do mestre.
  delta         Json?
  /// Resultado de dado associado (d20), quando houver.
  roll          Int?
  /// Condições que o mestre ainda precisa aplicar em alguém ("Aplicar em…").
  pendingEffect Json?
  /// Ação declarada pelo jogador que espera o mestre (d20, dano, confirmar o alvo).
  pendingAction Json?
  revertedAt    DateTime?
  createdAt     DateTime  @default(now())

  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actor     User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
  @@map("log_entries")
}
