generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER
  PLAYER
}

enum CampaignStatus {
  DRAFT // mestre preparando
  LOBBY // aberta para os jogadores entrarem
  ACTIVE // aventura em andamento
  ENDED
}

enum AbilityKind {
  BASIC
  SKILL
}

enum LogType {
  DAMAGE
  HEAL
  MANA
  XP
  LEVEL
  ABILITY_USED
  DICE_ROLL
  CONDITION_ADDED
  CONDITION_REMOVED
  SUMMON_CREATED
  SUMMON_REMOVED
  SUMMON_UPDATED
  ITEM_ADDED
  ITEM_REMOVED
  ITEM_UPDATED
  CAMPAIGN
  NOTE
  TURN
  NPC_CREATED
  NPC_UPDATED
  NPC_REMOVED
}

/// Doação (item ou ouro, sem nada em troca) ou troca (item por item) entre jogadores.
enum TransferKind {
  GIFT
  TRADE
}

enum TransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// Se a condição ajuda (BUFF), atrapalha (DEBUFF) ou depende do alvo (NEUTRAL).
enum ConditionPolarity {
  BUFF
  DEBUFF
  NEUTRAL
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaignsMastered Campaign[]
  campaignSeats     CampaignPlayer[]
  characters        Character[]
  logEntries        LogEntry[]

  @@map("users")
}

model Campaign {
  id           String         @id @default(uuid())
  name         String
  description  String?
  status       CampaignStatus @default(DRAFT)
  masterId     String
  shownImageId String?        @unique
  createdAt    DateTime       @default(now())
  startedAt    DateTime?
  endedAt      DateTime?

  /// Combate (modo de turnos), ligado e desligado pelo mestre.
  inCombat  Boolean  @default(false)
  round     Int      @default(0)
  /// 0 = turno do mestre; i > 0 = personagem turnOrder[i - 1].
  turnIndex Int      @default(0)
  /// Ordem dos personagens no combate (ids). O mestre sempre abre a rodada.
  turnOrder String[] @default([])

  /// Loja do mercador aberta para os jogadores.
  shopOpen Boolean @default(false)

  master     User             @relation(fields: [masterId], references: [id])
  shownImage CampaignImage?   @relation("ShownImage", fields: [shownImageId], references: [id], onDelete: SetNull)
  images     CampaignImage[]  @relation("CampaignImages")
  players    CampaignPlayer[]
  characters Character[]
  npcs       Npc[]
  logEntries LogEntry[]
  transfers  Transfer[]

  @@map("campaigns")
}

model CampaignPlayer {
  campaignId String
  userId     String
  ready      Boolean  @default(false)
  joinedAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
  @@map("campaign_players")
}

model CharacterClass {
  id           String   @id // slug: "necromante", "raposa-vermelha"...
  name         String
  tagline      String? // subtítulo da ficha, ex.: "Torturador / Carrasco"
  categories   String[]
  identity     String
  mechanicName String
  mechanicText String
  baseHp       Int
  baseMana     Int
  color        String // cor de destaque da ficha (hex)
  artFile      String // caminho público da arte, ex.: "/classes/necromante.png"
  sortOrder    Int      @default(0)

  abilities  Ability[]
  characters Character[]

  @@map("character_classes")
}

/// Usar a habilidade só gasta a mana e grava no log; o mestre resolve o resto.
model Ability {
  id          String      @id @default(uuid())
  classId     String
  kind        AbilityKind
  name        String
  manaCost    Int         @default(0)
  description String
  /// Faixas de crítico, só como texto de referência: [{ "min": 18, "max": 20, "text": "..." }]
  crits       Json?
  sortOrder   Int         @default(0)
  /// Nível em que a habilidade é liberada para o personagem (1ª: 1, 2ª: 5, 3ª: 10).
  unlockLevel Int         @default(1)

  class CharacterClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, name])
  @@map("abilities")
}

model Character {
  id         String   @id @default(uuid())
  campaignId String
  userId     String
  classId    String
  name       String
  level      Int      @default(1)
  xp         Int      @default(0)
  hp         Int
  hpMax      Int
  mana       Int
  manaMax    Int
  /// Moedas de ouro: 3 a cada combate encerrado; gasta na loja ou doa a outro jogador.
  gold       Int      @default(0)
  notes      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id])
  class      CharacterClass  @relation(fields: [classId], references: [id])
  summons    Summon[]
  conditions Condition[]
  inventory  InventoryItem[]
  logEntries LogEntry[]
  sentTransfers     Transfer[] @relation("TransferFrom")
  receivedTransfers Transfer[] @relation("TransferTo")

  @@unique([campaignId, userId])
  @@map("characters")
}

model Summon {
  id          String   @id @default(uuid())
  characterId String
  name        String
  hp          Int
  hpMax       Int
  notes       String   @default("")
  createdAt   DateTime @default(now())

  character  Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  conditions Condition[]

  @@map("summons")
}

/// Inimigo/NPC controlado pelo mestre (age no turno do mestre).
model Npc {
  id         String   @id @default(uuid())
  campaignId String
  name       String
  hp         Int
  hpMax      Int
  notes      String   @default("")
  createdAt  DateTime @default(now())

  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  conditions Condition[]

  @@map("npcs")
}

/// Catálogo de condições (prisma/seed/conditions.json).
model ConditionDef {
  id             String            @id // slug: "sangrando", "lua-rubra"...
  name           String
  description    String
  polarity       ConditionPolarity @default(NEUTRAL)
  sortOrder      Int               @default(0)

  conditions Condition[]

  @@map("condition_defs")
}

model Condition {
  id             String            @id @default(uuid())
  characterId    String?
  summonId       String?
  npcId          String?
  defId          String?
  name           String
  description    String?
  source         String? // quem aplicou (texto livre ou nome do personagem)
  polarity       ConditionPolarity @default(NEUTRAL)
  createdAt      DateTime          @default(now())

  character Character?    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  summon    Summon?       @relation(fields: [summonId], references: [id], onDelete: Cascade)
  npc       Npc?          @relation(fields: [npcId], references: [id], onDelete: Cascade)
  def       ConditionDef? @relation(fields: [defId], references: [id], onDelete: SetNull)

  @@map("conditions")
}

model InventoryItem {
  id          String   @id @default(uuid())
  characterId String
  name        String
  qty         Int      @default(1)
  description String?
  /// Item do catálogo da loja (ver game/shop.ts), p.ex. "POTION_HEALTH". Null = item dado à mão pelo mestre.
  code        String?
  createdAt   DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("inventory_items")
}

/// Oferta de um jogador a outro, à espera do aceite. Os itens ficam sem FK (podem
/// sumir ou mudar de dono); o servidor reconfere tudo ao aceitar.
model Transfer {
  id         String         @id @default(uuid())
  campaignId String
  /// Personagem que oferece.
  fromId     String
  /// Personagem que recebe.
  toId       String
  kind       TransferKind
  status     TransferStatus @default(PENDING)
  /// Item oferecido e o nome dele na hora da oferta (para o popup).
  giveItemId String?
  giveName   String?
  giveQty    Int            @default(1)
  /// Doação de ouro (sem item).
  giveGold   Int            @default(0)
  /// Só na troca: item pedido ao outro jogador.
  askItemId  String?
  askName    String?
  askQty     Int            @default(1)
  createdAt  DateTime       @default(now())
  resolvedAt DateTime?

  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  from     Character @relation("TransferFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to       Character @relation("TransferTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@map("transfers")
}

model CampaignImage {
  id           String   @id @default(uuid())
  campaignId   String
  filename     String // nome no disco (uuid + extensão)
  originalName String
  title        String
  createdAt    DateTime @default(now())

  campaign Campaign  @relation("CampaignImages", fields: [campaignId], references: [id], onDelete: Cascade)
  shownIn  Campaign? @relation("ShownImage")

  @@map("campaign_images")
}

model LogEntry {
  id            String    @id @default(uuid())
  campaignId    String
  actorUserId   String?
  characterId   String?
  type          LogType
  /// Texto que os jogadores leem (narrado, sem números do que é do mestre).
  message       String
  /// Versão completa, só para o mestre (ex.: com a vida dos inimigos). Null = igual a `message`.
  masterMessage String?
  /// Valores antes/depois, usados pelo "desfazer" do mestre.
  delta         Json?
  /// Resultado de dado associado (rolagem avulsa), quando houver.
  roll          Int?
  revertedAt    DateTime?
  createdAt     DateTime  @default(now())

  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actor     User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
  @@map("log_entries")
}
