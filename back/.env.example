PORT=3100

# Banco do `npm run dev:db` (Postgres embutido). Na primeira vez rode o schema.sql nele.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=rpg

JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=7d

# Vazio em dev: o Vite repassa /api e /socket.io para a API.
CORS_ORIGIN=

# Quantos proxies confiar para descobrir o IP do cliente (padrão 1: o nginx em produção).
# Em dev, atrás do Vite, não faz diferença; 0 se a API for exposta direto, sem proxy.
TRUST_PROXY=1
