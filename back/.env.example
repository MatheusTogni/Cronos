# Copie para .env e ajuste.

# Desenvolvimento: banco do `npm run dev:db` (Postgres embutido na porta 5433).
# Produção: ver .env.production.example
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/rpg?schema=public"

# Gere um segredo longo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-segredo-longo"
JWT_EXPIRES_IN="7d"

PORT=3100
HOST=127.0.0.1

# Pasta das imagens enviadas pelo mestre (padrão: ./uploads, fora do git).
UPLOAD_DIR=

# Só se o front rodar em outra origem sem o proxy do Vite (normalmente vazio).
CORS_ORIGIN=
