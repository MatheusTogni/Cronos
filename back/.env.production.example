PORT=3008
HOST=127.0.0.1

# Banco criado à mão com encoding UTF8; tabelas pelo schema.sql
DATABASE_URL="postgresql://postgres:troque-esta-senha@localhost:5432/cronosdb?schema=public"

# Gere com: openssl rand -hex 32
JWT_SECRET="gere-um-segredo-novo-com-openssl-rand-hex-32"
JWT_EXPIRES_IN="7d"

# Imagens do mestre: back/uploads (fora do git; o deploy.sh não apaga)
UPLOAD_DIR=

# Front e API no mesmo domínio (o nginx repassa /api e /socket.io): fica vazio
CORS_ORIGIN=
